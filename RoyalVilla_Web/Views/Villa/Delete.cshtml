@using RoyalVilla_DTO
@model VillaDTO


<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Warning Alert -->
            <div class="alert alert-danger d-flex align-items-center mb-4" role="alert">
                <i class="bi bi-exclamation-triangle-fill fs-2 me-3"></i>
                <div>
                    <h5 class="alert-heading mb-1">Confirm Deletion</h5>
                    <p class="mb-0">Are you sure you want to delete this villa? This action cannot be undone.</p>
                </div>
            </div>

            <!-- Villa Card -->
            <div class="card">
                <div class="card-header bg-danger d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@Model.Name</h4>
                    <span class="fw-semibold">(Delete Villa)</span>
                </div>
                <div class="card-body">
                    <!-- Image -->
                    @if(Model.ImageUrl != null)
                    {
                        <div class="text-center mb-4">
                            <img src="@Model.ImageUrl" alt="@Model.Name" class="img-fluid rounded" style="max-height: 300px;">
                        </div>
                    }
                    else
                    {
                        <div class="text-center mb-4">
                            <img src="https://via.placeholder.com/300x200?text=No+Image" alt="@Model.Name" class="img-fluid rounded" style="max-height: 300px;">
                        </div>
                    }
                   @*  <div class="text-center mb-4">
                        <img src="#" alt="@Model.Name" class="img-fluid rounded" style="max-height: 300px;">
                    </div> *@

                    <!-- Price Display -->
                    <div class="mb-3">
                        <h3 class="text-success">
                            $@Model.Rate <small class="text-muted">/ night</small>
                        </h3>
                    </div>

                    <!-- Details Table -->
                    <table class="table table-bordered">
                        <tbody>
                            <tr>
                                <th style="width: 30%;">Villa ID</th>
                                <td>@Model.Id</td>
                            </tr>
                            <tr>
                                <th>Description</th>
                                <td>
                                    @Model.Details
                                </td>
                            </tr>
                            <tr>
                                <th>Occupancy</th>
                                <td><i class="bi bi-people me-2"></i>@Model.Occupancy Guests</td>
                            </tr>
                            <tr>
                                <th>Square Feet</th>
                                <td><i class="bi bi-rulers me-2"></i>@Model.Sqft sqft</td>
                            </tr>
                            <tr>
                                <th>Created Date</th>
                                <td>XX</td>
                            </tr>
                            <tr>
                                <th>Last Updated</th>
                                <td>XX</td>
                            </tr>
                        </tbody>
                    </table>

                    <!-- Confirmation Form -->
                    <form method="post">

                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" asp-controller="Villa" class="btn btn-secondary">
                                <i class="bi bi-x me-2"></i>Cancel
                            </a>

                            <button type="submit" class="btn btn-danger">
                                <i class="bi bi-trash me-2"></i>Delete Permanently
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

