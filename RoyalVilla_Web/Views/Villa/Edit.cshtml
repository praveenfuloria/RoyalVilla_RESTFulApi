@using RoyalVilla_DTO
@model VillaUpdateDTO


<div class="container my-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Villa Card -->
            <div class="card">
                <div class="card-header bg-warning d-flex justify-content-between align-items-center">
                    <h4 class="mb-0">@Model.Name</h4>
                    <span class="fw-semibold">(Update Villa)</span>
                </div>
                <div class="card-body">
                    <form method="post">

                        <!-- Current Image Preview -->
                        <div class="text-center mb-4">
                            <img src="@Model.ImageUrl" alt="Current" class="img-fluid rounded" style="max-height: 300px;">
                            <p class="text-muted small mt-2">Current Image</p>
                        </div>

                        <!-- Form Fields in Table Format -->
                        <table class="table table-bordered">
                            <tbody>
                                <tr>
                                    <th style="width: 30%;">Villa ID</th>
                                    <td>@Model.Id</td>
                                </tr>
                                <tr>
                                    <th>
                                        <label class="mb-0">
                                            Villa Name <span class="text-danger">*</span>
                                        </label>
                                    </th>
                                    <td>
                                        <input class="form-control" asp-for="@Model.Name" />
                                        <span class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        <label class="mb-0">Description</label>
                                    </th>
                                    <td>
                                        <textarea class="form-control" asp-for="@Model.Details" rows="4"></textarea>.
                                        <span class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        <label class="mb-0">
                                            Nightly Rate <span class="text-danger">*</span>
                                        </label>
                                    </th>
                                    <td>
                                        <div class="input-group">
                                            <span class="input-group-text">$</span>
                                            <input type="number" step="0.01" asp-for="@Model.Rate" class="form-control" />
                                            <span class="text-danger small"></span>
                                        </div>
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        <label class="mb-0">Max Occupancy</label>
                                    </th>
                                    <td>
                                        <input type="number" asp-for="@Model.Occupancy" class="form-control" />
                                        <span class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        <label class="mb-0">Square Feet</label>
                                    </th>
                                    <td>
                                        <input type="number" asp-for="@Model.Sqft" class="form-control" />
                                        <span class="text-danger small"></span>
                                    </td>
                                </tr>
                                <tr>
                                    <th>
                                        <label class="mb-0">Image URL</label>
                                    </th>
                                    <td>
                                        <input asp-for="@Model.ImageUrl" class="form-control" />
                                        <span class="text-danger small"></span>
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <!-- Action Buttons -->
                        <div class="d-flex gap-2 justify-content-end">
                            <a asp-action="Index" asp-controller="Villa" class="btn btn-secondary">
                                <i class="bi bi-x me-2"></i>Cancel
                            </a>

                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check me-2"></i>Update Villa
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
